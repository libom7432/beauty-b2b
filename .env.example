# Optional. Set only when a real production domain is ready.
# Without this value, SEO metadata stays noindex and sitemap.xml stays empty.
NEXT_PUBLIC_SITE_URL=

# Admin A1. Set from the real Supabase project only in the deployment environment.
# The publishable key is public; never place a service role/secret key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only, non-owner PostgreSQL login provisioned separately with SET ROLE
# membership in admin_directory_reader. Never prefix with NEXT_PUBLIC_ .
ADMIN_DIRECTORY_DATABASE_URL=
